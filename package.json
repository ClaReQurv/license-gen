{
  "name": "@mcnaveen/license-gen",
  "version": "2.1.0",
  "description": "Utility to generate a license key in Node.js projects",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "jest",
    "test:i": "jest --coverageReporters=html --collect-coverage",
    "test:coverage": "jest --coverage --detectOpenHandles",
    "lint": "eslint \"./src/**/*.js\"",
    "lint:fix": "eslint \"./src/**/*.js\" --fix",
    "build": "tsc && tsup-node src/tsup.config.ts",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcnaveen/license-gen.git"
  },
  "bugs": {
    "url": "https://github.com/mcnaveen/license-gen/issues"
  },
  "homepage": "https://github.com/mcnaveen/license-gen#readme",
  "author": "mcnaveen <me@mcnaveen.com>",
  "keywords": [
    "license",
    "license-key",
    "license-key-generator"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "all-contributors-cli": "^6.24.0",
    "eslint": "^8.32.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.26.0",
    "gacp": "^3.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  },
  "dependencies": {},
  "gacp": {
    "add": false,
    "push": false,
    "emoji": "emoji",
    "editor": false
  }
}
